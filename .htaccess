<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve actual files/directories normally
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback
  RewriteRule ^ index.html [L]
</IfModule>

# Default page
DirectoryIndex index.html

# Optional security basics
Options -Indexes
ServerSignature Off